# ==============================================================================
# EMPIRIA Platform — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=EMPIRIA Platform
DEBUG=true

# Database Configuration (PostgreSQL 17)
# For local development with dedicated cluster on port 5433:
DATABASE_URL=postgresql+psycopg://postgres:@localhost:5433/empiria
DATABASE_SCHEMA=public

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security Secrets (Must be changed in production deployments)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-32chars
SESSION_COOKIE_NAME=empiria_session
SESSION_EXPIRE_HOURS=24
CSRF_COOKIE_NAME=empiria_csrf

# Tenant & Reporting Policy Defaults
DEFAULT_MIN_COHORT_THRESHOLD=5
MAX_CSV_UPLOAD_BYTES=10485760
